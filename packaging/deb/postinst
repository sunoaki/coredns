#!/bin/sh
set -e

if ! getent group coredns >/dev/null; then
    addgroup --system coredns
fi

if ! getent passwd coredns >/dev/null; then
    adduser --system --ingroup coredns --home /var/lib/coredns --no-create-home coredns
fi

mkdir -p /var/lib/coredns
chown coredns:coredns /var/lib/coredns

if command -v systemctl >/dev/null; then
    systemctl daemon-reload || true
    systemctl enable coredns.service || true
fi

exit 0
